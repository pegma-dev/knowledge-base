{
  "name": "knowledge-base",
  "version": "0.0.0",
  "private": true,
  "description": "Composable product documentation and support knowledge for Pegma hosts.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -b --pretty false && tsc -p tsconfig.test.json --pretty false",
    "clean": "tsc -b --clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm run build && vitest run && pnpm run test:release",
    "test:release": "node scripts/test-release.mjs",
    "release:check": "node scripts/release-packages.mjs check",
    "release:pack": "node scripts/release-packages.mjs pack",
    "release:prepare": "node scripts/release-packages.mjs prepare",
    "release:preflight": "node scripts/release-packages.mjs preflight",
    "release:publish": "node scripts/release-packages.mjs publish",
    "release:verify": "node scripts/release-packages.mjs verify",
    "example": "pnpm run build && node --experimental-strip-types examples/composition/run.ts",
    "agent:proof": "node scripts/agent-protocol-proof.mjs"
  },
  "devDependencies": {
    "@azure/data-tables": "13.3.2",
    "@cfworker/json-schema": "4.1.6",
    "@cloudflare/workers-types": "5.20260730.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@pegma/authorization-core": "0.4.0",
    "@pegma/knowledge-base-application": "0.1.8",
    "@pegma/knowledge-base-application-previous": "npm:@pegma/knowledge-base-application@0.1.1",
    "@pegma/knowledge-base-contracts": "0.1.8",
    "@pegma/knowledge-base-core": "0.1.8",
    "@pegma/knowledge-base-mcp": "0.1.8",
    "@pegma/spine": "0.1.2",
    "@pegma/storage-azure-tables": "0.4.0",
    "@pegma/storage-cloudflare-d1": "0.4.6",
    "@pegma/storage-core": "0.4.0",
    "@types/node": "26.6.6",
    "azurite": "3.37.0",
    "miniflare": "4.20260730.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  },
  "packageManager": "pnpm@10.34.5"
}
