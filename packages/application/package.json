{
  "name": "@pegma/knowledge-base-application",
  "version": "0.1.2",
  "description": "Authorized knowledge authoring, evidence, review, and publication over Pegma storage.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/*.js",
    "dist/**/*.js.map"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pegma-dev/knowledge-base.git",
    "directory": "packages/application"
  },
  "dependencies": {
    "@pegma/audit": "0.2.0",
    "@pegma/authorization-core": "0.4.0",
    "@pegma/knowledge-base-contracts": "0.1.2",
    "@pegma/knowledge-base-core": "0.1.2",
    "@pegma/spine": "0.1.2",
    "@pegma/storage-core": "0.4.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepack": "pnpm run --silent build"
  }
}
